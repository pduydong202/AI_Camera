# Example RTSP camera configuration
# Copy this file to .env and configure your camera.

CAM01_RTSP="rtsp://192.0.2.10:5678/cam01"

# Optiplex LAN/VPN base URL. Use the same token on sender and receiver.
VIDEO_SERVER_URL="http://192.0.2.50:8080"
VIDEO_SERVER_TOKEN="replace-with-a-long-random-token"
